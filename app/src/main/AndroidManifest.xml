    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Development permission, self-granted via the helper daemon (pm grant) so the in-app
         log recorder sees the daemon's logcat lines (different uid; an app only sees its own).
         Takes effect for the recorder on the next app process start (gid is set at fork). -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Development permission, self-granted over ADB (pm grant) while the classic port is
         still alive. Needed to turn Android's own wireless debugging back on after a reboot
         on firmwares that no longer keep port 5555 open (see AdbRestoreManager). -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- The camera permission is for the head unit's own cameras; the app runs fine without one. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <provider android:authorities="com.byd.car.server.provider.CarServiceProvider" />
        <!-- ACTION_DIAL (call action — user taps green button to actually dial) -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- ACTION_VIEW for url action -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- ACTION_VIEW for navigate action (Yandex Navigator deep-link) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="yandexnavi" />
        </intent>
        <!-- Launcher apps picker (app_launch action) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- SOME/IP gateway capability probe (HudSomeIpBridge.isServicePresent) -->
        <package android:name="com.ts.car.someip.service" />
    </queries>

    <application
        android:name=".BYDMateApp"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BYDMate">

        <activity android:name=".local.LocalToolsActivity" android:exported="false" />
        <service android:name=".local.LocalLockSoundService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".local.LocalBackupActivity" android:exported="false" />
        <activity android:name=".local.LocalMediaActivity" android:exported="false" />
        <activity android:name=".local.LocalCameraActivity" android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Split-screen backdrop: fullscreen NavyDark activity, lives while a split session
             is active. Not exported; started by SplitOverlayController. -->
        <activity
            android:name=".split.SplitStageActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BYDMate" />

        <service
            android:name=".service.TrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <service
            android:name=".cluster.SteeringWheelKeyService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".media.MediaSessionListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- BootReceiver: exact same config as DiPlus (the ONLY app that autostarts on DiLink) -->
        <!-- BootReceiver: WorkManager approach (like BydConnect) -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="9900">
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <!-- Sent by bydmatecn_helper (shell uid) after the Android 10 a11y recovery force-stop:
                     TrackingService is not exported, an explicit broadcast to this receiver is the
                     only way back in. Starting our own service is all it can do. -->
                <action android:name="com.bydmatecn.app.action.RECOVER_START" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.HOME" />
            </intent-filter>
        </receiver>

        <!-- UI7 cluster probe (test builds): driven from a Mac with `am broadcast`, see ClusterProbeRunner -->
        <receiver
            android:name=".cluster.ClusterProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.bydmatecn.app.CLUSTER_PROBE" />
            </intent-filter>
        </receiver>

        <!-- Diagnostic fid recorder (scripts/fid-record.sh). Exported like the cluster probe and
             gated to -test/debug builds inside the receiver. -->
        <receiver
            android:name=".data.push.FidRecorderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.bydmatecn.app.FID_RECORD" />
            </intent-filter>
        </receiver>

        <!-- Helper daemon binder delivery on firmwares that refuse addService to the shell
             domain (#64/#148). Exported by necessity: the sender is the shell uid, not us —
             HelperBinderHolder authenticates by spawn token + interface descriptor. -->
        <receiver
            android:name=".helper.HelperBinderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.bydmatecn.app.helper.BINDER" />
            </intent-filter>
        </receiver>

        <!-- Disable default WorkManager initializer (using Hilt custom config) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
